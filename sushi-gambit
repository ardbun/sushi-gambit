local WASH_KEYS = { Q = 0x51, E = 0x45, R = 0x52, F = 0x46 }


-- Process ONE key at a time (the first valid entry), let next scheduler tick handle the rest
-- This prevents spamming and respects queue ordering
scheduler:addLoop("washing", TIMINGS.washing, function()
    if not SETTINGS.Auto.Washing.Enabled or not HAS.memory then
        return
    end


    local g = PlayerGui:FindFirstChild("DishWashingGui")
    if not g or not g.Address then
        return
    end


    if mr("byte", g.Address + ScreenGuiEnabled) ~= 1 then
        return
    end


    -- Only auto-wash if there are clean/available dishes
    local sink = child(workspace, "Kitchen", "TheSink")
    local cleanDishes = sink and sink:FindFirstChild("CleanDishAmount")
    if cleanDishes and cleanDishes.Value ~= nil and cleanDishes.Value <= 0 then
        return
    end



    local holder = child(
        g,
        "MainFrame",
        "QueueBarFrame",
        "Queue",
        "KeysHolder"
    )


    if not holder then
        return
    end


    -- Find and process the first valid key in the queue.
    -- The next scheduler tick handles the following key.
    for _, c in ipairs(holder:GetChildren()) do
        if c.Name == "KeyTemplate" then
            local label = child(c, "Container", "TextLabel")
            local key = label and (label.Text or ""):upper():gsub("%s+", "")
            local vk = WASH_KEYS[key]
            if vk then
                if pcall(kp, vk) then
                    task.wait(0.01)
                    pcall(kr, vk)
                end
                return
            end
        end
    end
end)


local GroupId, MinRank = SETTINGS.Staff.GroupId, SETTINGS.Staff.MinRank
local KnownPlayers = {}


local function GetRankInGroup(uid, gid)
    local o, r = pcall(function()
        return game:HttpGet("https://groups.roblox.com/v2/users/" .. uid .. "/groups/roles")
    end)
    if not o or not r or r == "" then
        return nil, "Unknown"
    end
    local ok, data = pcall(function()
        return Http:JSONDecode(r)
    end)
    if not ok or type(data) ~= "table" then
        return 0, "Unknown"
    end
    for _, e in ipairs(data.data or {}) do
        local g = e and e.group
        if g and g.id == gid then
            local role = e.role or {}
            return role.rank or 0, role.name or "Unknown"
        end
    end
    return 0, "Unknown"
end


local function CheckStaff(p)
    local u = p and p.UserId
    if not u or KnownPlayers[u] then
        return
    end
    KnownPlayers[u] = "checking"
    task.spawn(function()
        local r, role = GetRankInGroup(u, GroupId)
        if r == nil then
            KnownPlayers[u] = nil
            return
        end
        KnownPlayers[u] = p.Name
        if r >= MinRank and SETTINGS.Staff.Notify then
            nt(p.Name .. " (" .. role .. ") joined!", "STAFF ALERT", 10)
        end
    end)
end


local function ScanStaff()
    local p = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player.UserId then
            p[player.UserId] = true
            CheckStaff(player)
        end
    end
    for u in pairs(KnownPlayers) do
        if not p[u] then
            KnownPlayers[u] = nil
        end
    end
end


