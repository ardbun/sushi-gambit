function scheduler:addLoop(n, i, f)
    self._loops[n] = { interval = i, timer = 0, fn = f, running = false }
end

function scheduler:remove(n)
    self._loops[n] = nil
end

function scheduler:clearAll()
    for n in pairs(self._loops) do
        self._loops[n] = nil
    end
end

local function runLoop(n, j)
    if j.running then return end
    j.running = true
    local o, e = pcall(j.fn)
    j.running = false
    if not o then
        warn("job '" .. n .. "': " .. tostring(e))
    end
end

Connections[#Connections + 1] = RunS.Heartbeat:Connect(function(dt)
    for n, j in pairs(scheduler._loops) do
        j.timer = j.timer + dt
        if j.timer >= j.interval and not j.running then
            j.timer = 0
            task.spawn(function()
                runLoop(n, j)
            end)
        end
    end
end)

local function nt(m, t, d)
    pcall(function()
