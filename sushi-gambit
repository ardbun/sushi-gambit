function Windows:Show(s)
    for _, e in ipairs(self.Elements) do
        e.Visible = s
    end
    for _, l in ipairs(self.Labels) do
        l.drawing.Visible = s
    end
end

function Windows:Delete()
    for _, e in ipairs(self.Elements) do
        pcall(function()
            e:Remove()
        end)
    end
    for _, l in ipairs(self.Labels) do
        pcall(function()
            l.drawing:Remove()
        end)
    end
    self.Elements = {}
    self.Labels = {}
end

function Windows:AddLabel(t, c)
    local d = Drawing.new("Text")
    d.Text = t or ""
    d.Size = 22
    d.Color = c or Color3.new(1, 1, 1)
    d.Outline = true
    d.Visible = false
    d.Font = FONT
    d.Position = Vector2.new(self.Position.X + 12, self.Position.Y + 38 + #self.Labels * 22)

    local e = { drawing = d }
    self.Labels[#self.Labels + 1] = e

    local h = {}
    function h:SetText(t)
        d.Text = t
    end
    function h:Delete()
        pcall(function()
            d:Remove()
        end)
        for i, item in ipairs(Windows.Labels) do
            if item == e then
                table.remove(Windows.Labels, i)
                break
            end
        end
    end
    return h
end

