-- Memory restoration cache
local memCache = {}


local scheduler = { _loops = {} }


local function cacheMemory(addr, value, typeTag)
    if not memCache[addr] then
        memCache[addr] = { value = value, type = typeTag }
    end
end


local function restoreMemory()
    for addr, data in pairs(memCache) do
        pcall(function()
            if data.type == "float" then
                mw("float", addr, data.value)
            elseif data.type == "byte" then
                mw("byte", addr, data.value)
            end
        end)
    end
    -- Clear cache after restoration
    memCache = {}
end


function scheduler:addLoop(n, i, f)
    self._loops[n] = { interval = i, timer = 0, fn = f, running = false }
end


function scheduler:remove(n)
    self._loops[n] = nil
end


function scheduler:clearAll()
    for n in pairs(self._loops) do
        self._loops[n] = nil
    end
end


local function runLoop(n, j)
    if j.running then return end
    j.running = true
    local o, e = pcall(j.fn)
    j.running = false
    if not o then
        warn("job '" .. n .. "': " .. tostring(e))
    end
end


local Connections = {}


Connections[#Connections + 1] = RunS.Heartbeat:Connect(function(dt)
    for n, j in pairs(scheduler._loops) do
        j.timer = j.timer + dt
        if j.timer >= j.interval and not j.running then
            j.timer = 0
            task.spawn(function()
                runLoop(n, j)
            end)
        end
    end
end)


