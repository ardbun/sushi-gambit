local function setPromptHold(p)
    if not (p and p.Address) then
        return
    end
    local patchAddr = p.Address + HoldDuration
    -- Cache original value BEFORE first modification by reading memory
    if not memCache[patchAddr] then
        cacheMemory(patchAddr, mr("float", patchAddr), "float")
    end
    pcall(function()
        mw("float", patchAddr, 0)
    end)
end


