local function showAlert(m, c, k)
    if alertDrawings[k] then
        pcall(function()
            alertDrawings[k]:Remove()
        end)
    end

    local t = Drawing.new("Text")
    local cam = workspace.CurrentCamera

    t.Text = m
    t.Size = 28
    t.Color = c or Color3.new(1, 1, 1)
    t.Outline = true
    t.Center = true
    t.Font = FONT
    t.Position = Vector2.new(cam and math.floor(cam.ViewportSize.X / 2) or 960, 144)
    t.Visible = true

