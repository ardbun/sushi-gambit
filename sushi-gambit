    end)
end

local function child(o, ...)
    for _, n in ipairs({ ... }) do
        o = o and o:FindFirstChild(n)
    end
    return o
end

local function each(o, f)
    if o then
        for _, i in ipairs(o:GetChildren()) do
            f(i)
        end
    end
end

local function val(o, n, d)
    o = o and o:FindFirstChild(n)
    return o and o.Value or d or 0
end

local function setVal(o, n, v)
    o = o and o:FindFirstChild(n)
    if o then
        pcall(function()
            o.Value = v
        end)
    end
end

