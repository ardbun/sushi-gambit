scheduler:addLoop("npcAlerts", TIMINGS.npcAlerts, function()
    local f = child(workspace, "NpcDestination", "SpawnedNPCs")
    if not f then
        return
    end


    local cSeen = false
    local iSeen = false


    each(f, function(n)
        local addr = n.Address
        local state = n:GetAttribute("CurrentState")
        if not addr then
            return
        end


        local isC = n:GetAttribute("Critic") == true and state ~= "Leaving" and state ~= "Left" and state ~= "Done"
        local isI = n:GetAttribute("Behavior") == "Inspector"


        cSeen = cSeen or isC
        iSeen = iSeen or isI


        if (isC or isI) and not notifiedNpcs[addr] then
            notifiedNpcs[addr] = true
            if isI then
                showAlert("health inspector", Color3.fromRGB(0, 255, 0), "inspector")
            end
            if isC then
                showAlert("critic", Color3.fromRGB(255, 252, 0), "critic")
            end
        elseif not (isC or isI) then
            notifiedNpcs[addr] = nil
        end
    end)


    if not cSeen then
        removeAlert("critic")
    end
    if not iSeen then
        removeAlert("inspector")
    end
end)


